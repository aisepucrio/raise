# Configuration for docker-compose.yaml and for running the Go binaries
# directly (cd backend-go; set -a; source ../.env; set +a). Copy to .env.
#
# Platform tokens (GitHub, Jira, Stack Overflow, GitLab) don't go here: admins
# add them through the API (POST /api/credentials), encrypted in the database.

# ---- Backend (backend-go) ----

# Required. Credential encryption keys: "<version>:<base64 32 bytes>", comma
# separated; the highest version encrypts. Generate with: cd backend-go && make keygen
# Back this value up: credentials can't be decrypted without it.
ENCRYPTION_KEYS=

# Used when running the binaries directly. docker compose overrides it.
DATABASE_URL=postgres://raise:raise@localhost:5433/raise?sslmode=disable
LOG_LEVEL=info

# API
HTTP_ADDR=:8000
# Set to true when the app is served over HTTPS.
SECURE_COOKIES=false
# Set to true behind a reverse proxy (nginx) so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# First admin account. On its first start with an empty database, the API
# creates this admin, so you can log in to the web interface right away.
# Once any user exists these are ignored (changing them later changes
# nothing): change the password in the web interface (Change password).
# Set both, or leave both empty and use `raisectl user create` instead.
# The password needs at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Git mining. Relative to backend-go/ when running the binaries directly;
# docker compose overrides it with /data/mirrors.
GIT_MIRROR_DIR=./data/mirrors
GIT_COMMIT_BATCH_SIZE=500
# Parallel git jobs per worker; defaults to the number of CPUs.
# GIT_CONCURRENCY=

# Forges
GITHUB_API_URL=https://api.github.com
# Mining uses the GraphQL API. Derived from GITHUB_API_URL when unset
# (GitHub Enterprise: https://host/api/v3 -> https://host/api/graphql).
# GITHUB_GRAPHQL_URL=
GITHUB_HOSTS=github.com
GITHUB_CONCURRENCY=20
GITLAB_HOSTS=gitlab.com

# ---- Frontend ----

# API origin the browser calls. Leave it empty: the Vite dev server (and nginx
# with --profile production) proxies /api/ on the frontend's own origin, which
# the session cookie and CSRF protection require. An absolute URL bypasses
# the proxy, and the API sends no CORS headers.
VITE_API_URL=
# Where the Vite dev server proxies /api/ when run on the host (npm run dev).
# docker compose sets it to http://api:8000.
# API_PROXY_TARGET=http://localhost:8000
# "False" makes the frontend container build into dist/ (for nginx) instead of
# running the Vite dev server.
IS_DEBUG=True
